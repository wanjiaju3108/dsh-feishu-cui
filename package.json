{
  "name": "dsh-feishu-cui",
  "version": "0.1.0",
  "description": "不用自己处理运维的远程 DSH：拿飞书私聊当操作界面（CUI），消息与卡片走飞书机器人长连接",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/settings/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "author": "WanJiaju",
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "@larksuiteoapi/node-sdk": "^1.74.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && for f in $(find lib -name '*.js'); do node --check \"$f\" || exit 1; done",
    "test": "node test/all.mjs"
  }
}
